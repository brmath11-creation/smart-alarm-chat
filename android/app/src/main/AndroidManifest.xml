<!-- Izin Perangkat Keras: Efek Getar Motor Penuh (Hardware Vibrator) -->
<uses-permission android:name="android.permission.VIBRATE"/>

<!-- STREAMING_CHUNK:Configuring wake lock and full screen alarm permissions... -->
<!-- Izin Membangunkan Layar HP dari Kondisi Layar Mati/Terkunci (WakeLock) -->
<uses-permission android:name="android.permission.WAKE_LOCK"/>

<!-- Izin Menampilkan Tampilan Penuh Merah Saat Layar HP Terkunci (Full Screen Intent) -->
<uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

<!-- Izin Ketepatan Waktu Alarm Presisi di Android Modern -->
<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

<!-- STREAMING_CHUNK:Configuring application activity and screen wake behavior... -->
<application
    android:label="Smart Alarm by Pak Bagas"
    android:name="${applicationName}"
    android:icon="@mipmap/ic_launcher">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTop"
        android:taskAffinity=""
        android:theme="@style/LaunchTheme"
        android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
        android:hardwareAccelerated="true"
        android:windowSoftInputMode="adjustResize"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:keepScreenOn="true">
        <!-- Menentukan tema Android saat Flutter UI menginisialisasi -->
        <meta-data
          android:name="io.flutter.embedding.android.NormalTheme"
          android:resource="@style/NormalTheme"
          />
        <intent-filter>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent-filter>
    </activity>
    <!-- Diperlukan oleh engine Flutter -->
    <meta-data
        android:name="flutterEmbedding"
        android:value="2" />
</application>
